# =============================================================================
# SafeRoute Bengaluru — Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/db
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://user:password@host:5432/db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT Auth ---
JWT_SECRET_KEY=your_secure_random_secret_here_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Twilio (for SMS / OTP) ---
# Set SMS_BACKEND=mock for development (logs OTP to console)
# Set SMS_BACKEND=twilio for production
SMS_BACKEND=mock
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
TWILIO_PHONE_NUMBER=+1234567890

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Application ---
APP_NAME=SafeRoute Bengaluru
APP_VERSION=0.1.0
DEBUG=true

# --- Graph ---
GRAPH_REBUILD_ON_STARTUP=true

# --- Safety Score Weights ---
WEIGHT_CCTV=0.30
WEIGHT_CROWD=0.25
WEIGHT_EMERGENCY=0.20
WEIGHT_LIGHTING=0.15
WEIGHT_CRIME=0.10

# --- Routing ---
# Default alpha/beta/gamma for edge cost
ROUTE_ALPHA=0.5
ROUTE_BETA=0.3
ROUTE_GAMMA=0.2
# Number of routes for Yen's K-shortest
ROUTE_K=3
